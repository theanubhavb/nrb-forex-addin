{
    "allowCustomDataForDataTypeAny": true,
    "functions": [
        {
            "description": "Test NRB API Connection",
            "id": "NRB.TestConnection",
            "name": "TestConnection",
            "namespace": "NRB",
            "parameters": [],
            "result": {
                "type": "string"
            },
            "volatile": false
        },
        {
            "description": "Get NRB Forex Rate (smart single/range return)",
            "id": "NRB.ForexRate",
            "name": "ForexRate",
            "namespace": "NRB",
            "parameters": [
                {
                    "description": "Start date",
                    "name": "fromDate",
                    "type": "any"
                },
                {
                    "description": "End date (optional)",
                    "name": "toDate",
                    "optional": true,
                    "type": "any"
                },
                {
                    "description": "Currency pair (default: USDNPR)",
                    "name": "currencyPair",
                    "optional": true,
                    "type": "string"
                },
                {
                    "description": "B for Buy, S for Sell (default: S)",
                    "name": "rateType",
                    "optional": true,
                    "type": "string"
                }
            ],
            "result": { "type": "any" },
            "volatile": false
        },
        {
            "description": "Helper function to parse JSON string back into table",
            "id": "NRB.ParseJSON",
            "name": "ParseJSON",
            "namespace": "NRB",
            "parameters": [
                {
                    "description": "JSON string returned by NRB.FOREXRATE",
                    "name": "jsonString",
                    "type": "string"
                }
            ],
            "result": {
                "dimensionality": "matrix",
                "type": "any"
            },
            "volatile": false
        }
    ]
}